# ==============================================================================
# QuarkDock Ecosystem Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the containers:
#   cp deploy/compose/.env.example deploy/compose/.env
# ==============================================================================

# --- Host Port Bindings ---
# If ports 3000 or 8000 are occupied by other local tools (e.g. Omni-Graph),
# change UI_PORT to 3002 and API_PORT to 8002.
OLLAMA_PORT=11434
API_PORT=8000
UI_PORT=3000
LANGFUSE_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Model Engine (Ollama) ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=24h
OLLAMA_HOST=0.0.0.0
OLLAMA_BASE_URL=http://ollama:11434

# --- Database (PostgreSQL for Langfuse) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=quarkdock_postgres_secret
POSTGRES_DB=langfuse

# --- Cache & Sessions (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- Observability (Langfuse v3) ---
DATABASE_URL=postgresql://postgres:quarkdock_postgres_secret@postgres:5432/langfuse
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=quarkdock_nextauth_secret_minimum_32_chars_apple_silicon_m5
SALT=quarkdock_salt_secure_random_seed_12345678
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true
TELEMETRY_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-quarkdock-local
LANGFUSE_SECRET_KEY=sk-lf-quarkdock-local
LANGFUSE_HOST=http://langfuse:3000

# --- Backend Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:3002","http://127.0.0.1:3000"]
MAX_CONCURRENT_REQUESTS=50
