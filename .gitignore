.installed.cfg
*.egg
MANIFEST

# Python virtual environments & package managers
.venv/
venv/
ENV/
env/
.uv/
.poetry/
poetry.lock

# Python testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Python linting & type checking
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
