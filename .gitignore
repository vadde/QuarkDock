!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Python runtime & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
